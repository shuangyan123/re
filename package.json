{
  "name": "tutor-benchmark",
  "version": "0.1.0",
  "description": "A provider-independent Developer Preview for evaluating observable AI tutoring behavior.",
  "license": "SEE LICENSE IN LICENSES.md",
  "keywords": [
    "ai tutoring",
    "benchmark",
    "evaluation",
    "tutoreval"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shuangyan123/tutorbench.git"
  },
  "homepage": "https://github.com/shuangyan123/tutorbench#readme",
  "bugs": {
    "url": "https://github.com/shuangyan123/tutorbench/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tutorbench": "./dist/src/cli/tutorbench.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "scenarios/",
    "prompts/",
    "assets/brand/tutorbench/web/",
    "assets/brand/tutorbench/raster/",
    "LICENSE",
    "LICENSES.md",
    "LICENSES/CC-BY-4.0.txt",
    "LICENSES/BRAND-POLICY.md",
    "NOTICE",
    "docs/licensing.md",
    "docs/quickstart.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "build": "tsc -p tsconfig.json",
    "quickstart": "npm run build && node dist/src/cli/tutorbench.js quickstart",
    "benchmark": "npm run build && node dist/src/cli/benchmark.js",
    "judge:openai": "npm run build && node dist/src/cli/judge-openai.js",
    "coverage": "npm run build && node dist/src/cli/dataset-coverage.js",
    "calibration:export": "npm run build && node dist/src/cli/calibration-export.js",
    "calibration:validate": "npm run build && node dist/src/cli/calibration-validate.js",
    "calibration:report": "npm run build && node dist/src/cli/calibration-report.js",
    "calibration:aggregate": "npm run build && node dist/src/cli/calibration-aggregate.js",
    "calibration:pilot:export": "npm run build && node dist/src/cli/calibration-pilot-export.js",
    "calibration:pilot:import": "npm run build && node dist/src/cli/calibration-pilot-import.js",
    "calibration:critical:export": "npm run build && node dist/src/cli/calibration-critical-export.js",
    "calibration:critical:prepare": "npm run build && node dist/src/cli/calibration-critical-prepare.js",
    "calibration:critical:validate": "npm run build && node dist/src/cli/calibration-critical-validate.js",
    "calibration:critical:report": "npm run build && node dist/src/cli/calibration-critical-report.js",
    "calibration:critical:aggregate": "npm run build && node dist/src/cli/calibration-critical-aggregate.js",
    "tutor:export-cases": "npm run build && node dist/src/cli/tutor-export-cases.js",
    "tutor:export-execution": "npm run build && node dist/src/cli/tutor-export-execution.js",
    "tutor:corpus:validate": "npm run build && node dist/src/cli/tutor-corpus-validate.js",
    "benchmark:corpus": "npm run build && node dist/src/cli/benchmark-corpus.js",
    "website:build": "npm run build && node dist/src/cli/website-build.js",
    "website:dev": "npm run website:build && node dist/src/cli/website-server.js",
    "test:governance": "node scripts/validate-governance.mjs",
    "typecheck:community-review-service": "tsc -p services/community-review-service/tsconfig.json --noEmit",
    "community-review:build": "tsc -p services/community-review-service/tsconfig.json",
    "community-review:portal:build": "node scripts/community-review-portal-build.mjs",
    "community-review:migrate": "npm run community-review:build && node services/community-review-service/dist/services/community-review-service/src/cli.js migrate",
    "community-review:readiness": "npm run community-review:build && node services/community-review-service/dist/services/community-review-service/src/cli.js readiness",
    "community-review:serve": "npm run community-review:build && npm run community-review:portal:build && node services/community-review-service/dist/services/community-review-service/src/cli.js serve",
    "test:community-review-service": "npm run community-review:portal:build && tsc -p services/community-review-service/tsconfig.json && node --test services/community-review-service/dist/services/community-review-service/tests/*.test.js",
    "test:community-review-service:postgres": "npm run community-review:portal:build && tsc -p services/community-review-service/tsconfig.json && node scripts/community-review-postgres-tests.mjs",
    "test:package": "npm run build && node scripts/package-consumer-smoke.mjs",
    "test:website": "npm run website:build && node scripts/website-artifact-smoke.mjs",
    "release:verify": "node scripts/verify-release-candidate.mjs"
  },
  "devDependencies": {
    "@auth0/auth0-spa-js": "2.24.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "openai": "7.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "peerDependencies": {
    "openai": "7.4.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  }
}
