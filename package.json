{
  "name": "tutor-benchmark",
  "version": "0.1.0",
  "description": "An independent, provider-independent foundation for evaluating Tutor behavior.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "build": "tsc -p tsconfig.json",
    "benchmark": "npm run build && node dist/src/cli/benchmark.js",
    "coverage": "npm run build && node dist/src/cli/dataset-coverage.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
